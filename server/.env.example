# Django settings
DJANGO_SECRET=secret_key
DEBUG=True # false for production
DJANGO_ALLOWED_HOSTS=*
# others

# Database settings (PostgreSQL)
DB_NAME=db_name
DB_USER=pg_user
DB_PASSWORD=pg_pass
DB_HOST=pg.example.com
DB_PORT=6543
# Optional: CA certificate path relative to server/ — enables sslmode=verify-full
# Optional: override sslmode (disable, prefer, require, verify-ca, verify-full)
# DB_SSLMODE=prefer